# Copy to terminal/router/.env (git-ignored). The key never reaches the browser.
OPENROUTER_API_KEY=
# Optional: override the model used for the general tiers (default openrouter/auto).
OPENROUTER_DEFAULT_MODEL=
# Optional: override the Jev decisions model (default typesafe/jev-1.13).
OPENROUTER_JEV_MODEL=
# Set to false to route by rules only (no Jev call).
ROUTER_USE_JEV=
# Optional: override the tagger tier model (default google/gemini-2.5-flash-lite; alternate openai/gpt-4.1-nano).
OPENROUTER_TAGGER_MODEL=
# Optional: lock CORS to your app origin in production, e.g. https://imagine-os.github.io
ROUTER_ALLOWED_ORIGIN=
# Optional: sent as HTTP-Referer to OpenRouter for attribution.
ROUTER_REFERER=
PORT=8787
