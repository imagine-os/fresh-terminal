{
  "name": "fresh-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fresh Terminal: a prompt-first terminal with boxes, a five-region shell and a plain-language layout dialect.",
  "scripts": {
    "dev": "concurrently -k -n app,router -c cyan,magenta \"pnpm dev:app\" \"pnpm dev:router\"",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:router": "tsx watch router/src/node.ts",
    "build": "pnpm build:app && pnpm build:router",
    "build:app": "vite build --config app/vite.config.ts && node scripts/spa-fallback.mjs && tsx scripts/build-wiki.ts",
    "build:router": "esbuild router/src/node.ts --bundle --platform=node --target=node22 --format=esm --outfile=router/dist/node.mjs --log-level=warning && tsc -p router/tsconfig.json --noEmit",
    "preview": "vite preview --config app/vite.config.ts",
    "typecheck": "tsc -p app/tsconfig.json --noEmit && tsc -p router/tsconfig.json --noEmit && tsc -p module/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:responsive": "tsx scripts/check-responsive.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify:chain": "tsx scripts/verify-chain.ts",
    "ledger:sample": "tsx scripts/make-ledger-sample.ts",
    "start:router": "node router/dist/node.mjs",
    "canvas:add": "tsx scripts/canvas-add.ts",
    "canvas:thumbs": "tsx scripts/canvas-thumbs.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spacetimedb": "^2.10.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "jsdom": "^26.0.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "esbuild": "^0.25.0"
  }
}
